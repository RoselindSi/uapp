# ─── Project artefacts (generated, not source) ───────────────────────────────
# Embedding caches and bio features — large + reproducible via scripts/01,06
cache/
# Experiment outputs (CSV/JSON/per-seed dirs) — reproducible via scripts/07,09
outputs/
# Model checkpoints / serialised tensors written by training runs
*.ckpt
*.pth

# Scope `*.pt` to generated locations only — keeps room for small fixtures
cache/**/*.pt
outputs/**/*.pt

